# Public origin serving the reference recordings.
#
# signs.json stores bucket-relative paths ("video/hello.mp4"); this is the
# origin they hang off, resolved at render time in src/lib/media.ts. Keeping it
# out of the generated data means the same signs.json works in dev, preview and
# production without a rebuild.
#
# Production: the R2 bucket's public URL, or a custom domain in front of it.
#   NEXT_PUBLIC_MEDIA_BASE_URL=https://media.fslames.example
#
# Unset, it falls back to /media, which serves web/public/media/ - copy or
# symlink your local media/ folder there to preview without R2.
NEXT_PUBLIC_MEDIA_BASE_URL=
